{
  "manifest_version": 3,
  "name": "STRATUS Company & Station Badge",
  "version": "1.1.2",
  "description": "Shows the current STRATUS company and freshly detected signed-in station in the top navigation bar.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gtpstratus.com/*",
        "https://*.gtpstratus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "STRATUS Company & Station Badge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
